<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="LocalLens - Review and discover local businesses in your community">
    <title>LocalLens</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Header Section -->
    <header class="header">                                                     
        <div class="container">
            <h1 class="logo">LocalLens</h1>
            <p class="tagline">Review and Discover Local Businesses</p>
        </div>
    </header>

    <!-- Main Navigation -->
    <nav class="main-nav">
        <div class="container">
            <ul class="nav-list">
                <li><a href="#home" class="nav-link active" data-section="home">Home</a></li>
                <li><a href="#browse" class="nav-link" data-section="browse">Browse Businesses</a></li>
                <li><a href="#favorites" class="nav-link" data-section="favorites">My Favorites</a></li>
                <li><a href="#deals" class="nav-link" data-section="deals">Special Deals</a></li>
                <li><a href="#reports" class="nav-link" data-section="reports">Reports</a></li>
            </ul>
        </div>
    </nav>

    <!-- Verification Modal (Bot Prevention) -->
    <div id="verificationModal" class="modal">
        <div class="modal-content">
            <h2>Verification Required</h2>
            <p>To prevent bot activity, please verify you're human:</p>
            <div class="verification-box">
                <p id="verificationQuestion" class="verification-question"></p>
                <input type="text" id="verificationAnswer" class="verification-input" placeholder="Enter answer">
                <button id="verifyBtn" class="btn btn-primary">Verify</button>
                <p id="verificationError" class="error-message"></p>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="main-content">
        <!-- Home Section -->
        <section id="home" class="section active">
            <div class="container">
                <div class="hero">
                    <h2>Welcome to LocalLens</h2>
                    <p>Your local business discovery platform that helps you find, explore, and support small businesses in your community.</p>
                </div>

                <!-- Search and Filter Controls -->
                <div class="controls-panel">
                    <div class="search-box">
                        <input type="text" id="searchInput" class="search-input" placeholder="Search businesses by name...">
                        <button id="searchBtn" class="btn btn-secondary">Search</button>
                    </div>

                    <div class="filter-group">
                        <label for="categoryFilter">Filter by Category:</label>
                        <select id="categoryFilter" class="filter-select">
                            <option value="all">All Categories</option>
                            <option value="food">Food & Dining</option>
                            <option value="retail">Retail & Shopping</option>
                            <option value="services">Services</option>
                        </select>
                    </div>   

                    <div class="sort-group">
                        <label for="sortBy">Sort by:</label>
                        <select id="sortBy" class="filter-select">
                            <option value="name">Name (A-Z)</option>
                            <option value="rating-high">Rating (High to Low)</option>
                            <option value="rating-low">Rating (Low to High)</option>
                            <option value="reviews">Most Reviews</option>
                        </select>
                    </div>
                </div>

                <!-- Statistics Dashboard -->
                <div class="stats-dashboard">
                    <div class="stat-card">
                        <h3 id="totalBusinesses">0</h3>
                        <p>Total Businesses</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="avgRating">0.0</h3>
                        <p>Average Rating</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="totalReviews">0</h3>
                        <p>Total Reviews</p>
                    </div>
                </div>

                <!-- Business Cards Container -->
                <div id="businessList" class="business-list"></div>
            </div>
        </section>

        <!-- Browse Section -->
        <section id="browse" class="section">
            <div class="container">
                <h2>Browse All Businesses</h2>
                <div id="browseBusinessList" class="business-list"></div>
            </div>
        </section>

        <!-- Favorites Section -->
        <section id="favorites" class="section">
            <div class="container">
                <h2>My Favorite Businesses</h2>
                <div id="favoritesList" class="business-list">
                    <p class="empty-message">No favorites yet. Start adding businesses you love!</p>
                </div>
            </div>
        </section>

        <!-- Special Deals Section -->
        <section id="deals" class="section">
            <div class="container">
                <h2>Special Deals & Coupons</h2>
                <div id="dealsList" class="deals-list"></div>
            </div>
        </section>

        <!-- Reports Section -->
        <section id="reports" class="section">
            <div class="container">
                <h2>Generate Reports</h2>
                <p>Customize and export business data for analysis</p>
                
                <div class="report-controls">
                    <div class="filter-group">
                        <h3>Filter Options</h3>
                        <div class="filter-item">
                            <label for="reportCategory">Category:</label>
                            <select id="reportCategory">
                                <option value="">All Categories</option>
                                <option value="food">Food & Beverage</option>
                                <option value="retail">Retail</option>
                                <option value="services">Services</option>
                                <option value="health">Health & Wellness</option>
                                <option value="entertainment">Entertainment</option>
                            </select>
                        </div>
                        <div class="filter-item">
                            <label for="reportRatingMin">Minimum Rating:</label>
                            <input type="number" id="reportRatingMin" min="0" max="5" step="0.1" placeholder="0.0" value="">
                        </div>
                        <div class="filter-item">
                            <label>
                                <input type="checkbox" id="reportOnlyFavorites"> Only Favorites
                            </label>
                        </div>
                    </div>

                    <div class="field-selection">
                        <h3>Select Fields to Include</h3>
                        <div class="checkbox-group">
                            <label><input type="checkbox" class="field-checkbox" value="name" checked> Business Name</label>
                            <label><input type="checkbox" class="field-checkbox" value="category" checked> Category</label>
                            <label><input type="checkbox" class="field-checkbox" value="address" checked> Address</label>
                            <label><input type="checkbox" class="field-checkbox" value="phone" checked> Phone</label>
                            <label><input type="checkbox" class="field-checkbox" value="rating" checked> Rating</label>
                            <label><input type="checkbox" class="field-checkbox" value="reviewCount"> Review Count</label>
                            <label><input type="checkbox" class="field-checkbox" value="description"> Description</label>
                            <label><input type="checkbox" class="field-checkbox" value="deal"> Current Deal</label>
                        </div>
                    </div>

                    <div class="report-actions">
                        <button id="generateCSVBtn" class="btn btn-primary">📥 Download CSV</button>
                        <button id="previewReportBtn" class="btn btn-secondary">👁️ Preview Report</button>
                        <button id="printReportBtn" class="btn btn-secondary">🖨️ Print</button>
                    </div>
                </div>

                <div id="reportPreview" class="report-preview" style="display: none;">
                    <h3>Report Preview</h3>
                    <div id="reportContent"></div>
                </div>
            </div>
        </section>
    </main>

    <!-- Business Detail Modal -->
    <div id="businessModal" class="modal">
        <div class="modal-content modal-large">
            <span class="close-btn" id="closeModal">&times;</span>
            <div id="businessModalContent"></div>
        </div>
    </div>



    <!-- Supabase configuration: injected at build time from environment variables -->
    <!-- To use Supabase, set SUPABASE_URL and SUPABASE_ANON_KEY environment variables before building -->
    <script>
        window.SUPABASE_URL = '%%SUPABASE_URL%%' || '';
        window.SUPABASE_ANON_KEY = '%%SUPABASE_ANON_KEY%%' || '';
    </script>


    <!-- Supabase client (UMD) -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js/dist/umd/supabase.min.js"></script>

    <script src="js/business-service.js"></script>
    <script src="js/data-manager.js"></script>
    <script src="js/verification.js"></script>
    <script src="js/report-generator.js"></script>
    <script src="js/ui-renderer.js"></script>
    <script src="js/app-state.js"></script>
    <footer class="site-footer">
        <div class="container">Created by Ilan Ravichandran, Prahast Pondugula</div>
    </footer>
</body>
</html>
